GROQ_API_KEY=your-groq-api-key-here
# e.g. llama-3.3-70b-versatile or llama-3.1-8b-instant (no groq/ prefix)
GROQ_MODEL=llama-3.3-70b-versatile

# Required for embedding-based RAG (OpenAI text-embedding-3-small)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: RAG tuning (defaults shown)
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=200
# RAG_RETRIEVE_TOP_K=5
# RAG_RERANK_TOP_N=2

PORT=3000
DB_FILE=./chat_history.db

# Optional auth (disabled by default for backward compatibility)
REQUIRE_AUTH=false
AUTH_ALLOW_API_KEY=true
AUTH_ALLOW_JWT=true
# Single API key or comma-separated key list
# AUTH_API_KEY=replace-with-strong-api-key
# AUTH_API_KEYS=key1,key2,key3
# Required only when AUTH_ALLOW_JWT=true
# AUTH_JWT_SECRET=replace-with-strong-jwt-secret

# Optional rate limiting (used for /ask and /ask/stream)
# Window in milliseconds (default 60000 = 1 minute)
# ASK_RATE_LIMIT_WINDOW_MS=60000
# Max requests per window by IP when no valid API key is present
# ASK_RATE_LIMIT_IP_MAX=60
# Max requests per window by API key when a valid API key is present
# ASK_RATE_LIMIT_API_KEY_MAX=120

